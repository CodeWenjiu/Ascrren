export component AppWindow inherits Window {
    width: 160px;
    height: 80px;
    background: #081018;

    in property <int> tick: 0;
    in property <string> label: "MSU2";

    VerticalLayout {
        padding: 6px;
        spacing: 4px;

        Text {
            text: root.label;
            color: #7fe7ff;
            font-size: 16px;
            horizontal-alignment: center;
        }

        Rectangle {
            height: 12px;
            border-radius: 3px;
            background: #162a38;

            Rectangle {
                x: 0;
                y: 0;
                height: parent.height;
                width: parent.width * Math.mod(root.tick, 100) / 100;
                border-radius: 3px;
                background: #37c8ff;
            }
        }

        Text {
            text: "160x80 RGB565";
            color: #668899;
            font-size: 10px;
            horizontal-alignment: center;
        }
    }
}