export component AppWindow inherits Window {
    width: 160px;
    height: 80px;
    background: #081018;

    // 页面：0 = 列表，1 = 详情
    in property <int> page: 0;
    in property <int> selected: 0;
    in property <bool> pressed: false;
    in property <float> hold-progress: 0.0;
    in property <string> detail-title: "Clock";
    in property <[string]> items: ["Clock", "System", "Settings"];

    if root.page == 0 : Rectangle {
        width: 160px;
        height: 80px;
        background: transparent;

        VerticalLayout {
            x: 6px;
            y: 4px;
            width: 148px;
            spacing: 2px;

            for item[index] in root.items : Rectangle {
                height: 18px;
                border-radius: 3px;
                background: index == root.selected ? #17475c : #0d1a24;

                Rectangle {
                    x: 0px;
                    width: index == root.selected ? 3px : 0px;
                    height: parent.height;
                    border-radius: 2px;
                    background: #37c8ff;
                }

                Text {
                    x: 10px;
                    width: 130px;
                    height: parent.height;
                    vertical-alignment: center;
                    text: item;
                    color: index == root.selected ? #a8eeff : #55707f;
                    font-size: 12px;
                }
            }
        }

        Rectangle {
            x: 6px;
            y: 66px;
            width: 148px;
            height: 3px;
            border-radius: 2px;
            background: #12242e;
        }

        Rectangle {
            x: 6px;
            y: 66px;
            width: 148px * root.hold-progress;
            height: 3px;
            border-radius: 2px;
            background: #37c8ff;
            visible: root.hold-progress > 0;
        }

        Text {
            x: 6px;
            y: 71px;
            width: 148px;
            horizontal-alignment: center;
            text: root.pressed ? "HOLD TO OPEN" : "TAP NEXT / HOLD OPEN";
            color: #3d5a6b;
            font-size: 8px;
        }
    }

    if root.page == 1 : Rectangle {
        width: 160px;
        height: 80px;
        background: transparent;

        Text {
            x: 0px;
            y: 14px;
            width: 160px;
            horizontal-alignment: center;
            text: root.detail-title;
            color: #a8eeff;
            font-size: 22px;
        }

        Text {
            x: 0px;
            y: 48px;
            width: 160px;
            horizontal-alignment: center;
            text: "DETAIL VIEW";
            color: #2f4a59;
            font-size: 9px;
        }

        Text {
            x: 0px;
            y: 62px;
            width: 160px;
            horizontal-alignment: center;
            text: "TAP TO BACK  /  HOLD TO HOME";
            color: #3d5a6b;
            font-size: 8px;
        }
    }
}
