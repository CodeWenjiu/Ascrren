export component AppWindow inherits Window {
    width: 160px;
    height: 80px;
    background: #081018;

    in property <int> page: 0;
    in property <bool> pressed: false;
    in property <[string]> titles: ["HELLO", "INPUT", "RENDER", "USB"];
    in property <[string]> subtitles: [
        "MSU2 160x80 RGB565",
        "TAP TO CYCLE PAGES",
        "SLINT SOFTWARE RENDER",
        "CDC ACM TILE DIFF"
    ];
    in property <[int]> dots: [0, 1, 2, 3];

    Text {
        x: 0px;
        y: 12px;
        width: 160px;
        horizontal-alignment: center;
        text: root.titles[root.page];
        color: root.pressed ? #ffffff : #7fe7ff;
        font-size: 24px;
    }

    Text {
        x: 0px;
        y: 48px;
        width: 160px;
        horizontal-alignment: center;
        text: root.subtitles[root.page];
        color: #55707f;
        font-size: 9px;
    }

    HorizontalLayout {
        x: 0px;
        y: 68px;
        width: 160px;
        alignment: center;
        spacing: 6px;

        for dot[index] in root.dots : Rectangle {
            width: 5px;
            height: 5px;
            border-radius: 3px;
            background: index == root.page ? #37c8ff : #1b2c36;
        }
    }
}
